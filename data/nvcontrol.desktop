[Desktop Entry]
Type=Application
Name=NV//CONTROL
GenericName=NVIDIA Control Center
Comment=GPU telemetry, tuning, display and per-game RTX settings
Exec=nvcontrol
Icon=nvcontrol
Terminal=false
Categories=System;Settings;HardwareSettings;Game;
Keywords=nvidia;gpu;geforce;rtx;dlss;overclock;fan;proton;steam;mangohud;
StartupWMClass=nvcontrol
Actions=Update;Diagnostics;Mock;

[Desktop Action Update]
Name=Update NV//CONTROL
Exec=nvcontrol --update

[Desktop Action Diagnostics]
Name=Run setup wizard
Exec=nvcontrol --wizard

[Desktop Action Mock]
Name=Demo mode (simulated GPU)
Exec=nvcontrol --mock
